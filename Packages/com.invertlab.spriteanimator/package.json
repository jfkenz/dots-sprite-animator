{
  "name": "com.invertlab.spriteanimator",
  "displayName": "DOTS Sprite Animator",
  "version": "0.8.1",
  "unity": "6000.0",
  "description": "Portable DOTS-first 2D flipbook sprite animation with timeline authoring, events, sockets, and Query/Unity2D colliders. Unity Physics (Character body + OverlapAabb) is optional via com.unity.physics.",
  "author": {
    "name": "InvertLab"
  },
  "dependencies": {
    "com.unity.entities": "1.4.2",
    "com.unity.entities.graphics": "1.4.16",
    "com.unity.render-pipelines.universal": "17.5.0"
  },
  "keywords": [
    "sprites",
    "animation",
    "dots",
    "entities",
    "editor"
  ],
  "samples": [
    {
      "displayName": "Playback API",
      "description": "Play / one-shot / facing API integration.",
      "path": "Samples~/PlaybackApiExample"
    },
    {
      "displayName": "Events",
      "description": "Frame animation events sample.",
      "path": "Samples~/EventsExample"
    },
    {
      "displayName": "Sockets",
      "description": "Socket attach points and sync.",
      "path": "Samples~/Sockets"
    },
    {
      "displayName": "Crowd GPU",
      "description": "GPU / crowd scale path.",
      "path": "Samples~/CrowdGpuExample"
    },
    {
      "displayName": "Collider Query",
      "description": "Query method + AABB hits (no Unity Physics package required).",
      "path": "Samples~/ColliderQueryExample"
    },
    {
      "displayName": "Collider Unity 2D Events",
      "description": "Unity 2D collider children + hit events.",
      "path": "Samples~/ColliderEventExample"
    },
    {
      "displayName": "Unity Physics",
      "description": "Optional com.unity.physics: Character body bake + frame AABB OverlapAabb. Requires Unity Physics package.",
      "path": "Samples~/UnityPhysicsExample"
    },
    {
      "displayName": "Showcase (Clembod)",
      "description": "Art/profile showcase sheets. Credit Clembod; for demos, not minimal integration.",
      "path": "Samples~/Showcase"
    }
  ],
  "license": "See LICENSE.md file",
  "licensesUrl": "https://unity.com/legal/as-terms"
}
